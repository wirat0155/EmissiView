@model List<EmissiView.Models.EnergyViewModel>

@{
    ViewData["Title"] = "MDB Real-Time Status";
}

@section Styles {
    <style>
        .mdb-container {
            padding: 24px;
        }

        .mdb-header {
            margin-bottom: 32px;
        }

        .mdb-header h1 {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .mdb-header p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: var(--primary-color);
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .back-btn:hover {
            background: #0d47a1;
            transform: translateX(-2px);
            box-shadow: var(--shadow-md);
        }

        .back-btn i {
            font-size: 16px;
        }

        .status-legend {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
            padding: 20px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }

        .legend-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .legend-item .status-dot {
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            margin-top: 2px;
        }

        .legend-item .status-dot.online {
            background: #10b981;
            animation: pulse-green 2s infinite;
        }

        .legend-item .status-dot.offline {
            background: #ef4444;
        }

        .legend-content {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .legend-label {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 14px;
        }

        .legend-desc {
            font-size: 12px;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        @@keyframes pulse-green {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        .mdb-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .mdb-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .mdb-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-2px);
        }

        .mdb-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #3b82f6, #1e40af);
        }

        .mdb-card.offline::before {
            background: linear-gradient(90deg, #ef4444, #dc2626);
        }

        .mdb-status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #10b981;
            animation: pulse-green 2s infinite;
        }

        .status-dot.offline {
            background: #ef4444;
            animation: none;
        }

        .status-text {
            font-size: 13px;
            font-weight: 600;
            color: #10b981;
        }

        .status-text.offline {
            color: #ef4444;
        }

        .mdb-id {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .mdb-plant {
            font-size: 13px;
            color: var(--text-secondary);
            text-transform: capitalize;
            margin-bottom: 16px;
        }

        .mdb-data-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .mdb-data-row:last-child {
            border-bottom: none;
        }

        .mdb-data-label {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .mdb-data-value {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .mdb-kwh {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-color);
        }

        .mdb-kwh-decimal {
            font-size: 13px;
            font-weight: 400;
            color: var(--text-secondary);
            opacity: 0.8;
        }

        .mdb-timestamp {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
        }

        .mdb-last-seen {
            font-size: 11px;
            color: var(--text-secondary);
            font-style: italic;
        }

        .mdb-empty {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-secondary);
        }

        .mdb-empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.5;
        }

        .mdb-refresh-info {
            text-align: center;
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 24px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 8px;
        }

        @@media (max-width: 768px) {
            .mdb-grid {
                grid-template-columns: 1fr;
            }

            .mdb-header h1 {
                font-size: 24px;
            }

            .back-btn {
                padding: 8px 12px;
                font-size: 12px;
            }

            .status-legend {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="container mdb-container">
    <div class="mdb-header">
        <div style="display: flex; align-items: center; gap: 15px; justify-content: space-between;">
            <div>
                <h1>MDB Real-Time Status</h1>
                <p>Live energy monitoring dashboard &mdash; Monthly consumption: @DateTime.Now.ToString("dd MMM yyyy")</p>
            </div>
            <a href="@Url.Action("Index", "ElectricChart")" class="back-btn" title="Back to Production Dashboard">
                <i class="ri-arrow-left-line"></i> Back
            </a>
        </div>
    </div>

    <!-- Status Legend -->
    <div class="status-legend">
        <div class="legend-item">
            <div class="status-dot online"></div>
            <div class="legend-content">
                <span class="legend-label">Online</span>
                <span class="legend-desc">Data received within last 5 minutes</span>
            </div>
        </div>
        <div class="legend-item">
            <div class="status-dot offline"></div>
            <div class="legend-content">
                <span class="legend-label">Offline</span>
                <span class="legend-desc">No data received for more than 5 minutes</span>
            </div>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card">
            <div class="mdb-empty">
                <div class="mdb-empty-icon">📊</div>
                <p>No Data Available</p>
                <p style="font-size: 12px; margin-top: 8px;">Waiting for MDB data...</p>
            </div>
        </div>
    }
    else
    {
        <div class="mdb-grid">
            @foreach (var item in Model.OrderBy(x => x.MDB))
            {
                <div class="mdb-card @(item.IsAlive ? "" : "offline")">
                    <div class="mdb-status-indicator">
                        <div class="status-dot @(item.IsAlive ? "" : "offline")"></div>
                        <span class="status-text @(item.IsAlive ? "" : "offline")">
                            @(item.IsAlive ? "Online" : "Offline")
                        </span>
                    </div>

                    <div class="mdb-id">MDB @item.MDB</div>
                    <div class="mdb-plant">@item.Plant</div>

                    <div class="mdb-data-row">
                        <span class="mdb-data-label">Energy (This Month)</span>
                        <span class="mdb-kwh">
                            @{
                                var kwhStr = item.kWh.ToString("N3");
                                var parts = kwhStr.Split('.');
                                var intPart = parts[0];
                                var decPart = parts.Length > 1 ? "." + parts[1] : "";
                            }
                            @intPart<span class="mdb-kwh-decimal">@decPart kWh</span>
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(item.FirstDate) && !string.IsNullOrEmpty(item.LastDate))
                    {
                        <div class="mdb-data-row" style="font-size: 11px; color: var(--text-secondary);">
                            <span class="mdb-data-label">Period</span>
                            <span>@(DateTime.Parse(item.FirstDate).ToString("dd MMM yyyy")) to @(DateTime.Parse(item.LastDate).ToString("dd MMM yyyy"))</span>
                        </div>
                    }

                    <div class="mdb-timestamp">
                        <div>@item.LastUpdate.ToString("dd MMM yyyy HH:mm:ss")</div>
                        <div class="mdb-last-seen">@item.LastSeenText</div>
                    </div>
                </div>
            }
        </div>

        <div class="mdb-refresh-info">
            <i class="ri-refresh-line"></i> Auto-refreshing every 10 seconds
        </div>
    }
</div>

@section Scripts {
    <script>
        (function() {
            const REFRESH_INTERVAL = 10000; // 10 seconds

            function refreshData() {
                fetch('@Url.Action("List", "Monitor")')
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const newDoc = parser.parseFromString(html, 'text/html');
                        const newContent = newDoc.querySelector('.mdb-container');
                        const currentContent = document.querySelector('.mdb-container');
                        
                        if (newContent && currentContent) {
                            currentContent.innerHTML = newContent.innerHTML;
                        }
                    })
                    .catch(error => console.error('Refresh error:', error));
            }

            // Initial load
            document.addEventListener('DOMContentLoaded', function() {
                setInterval(refreshData, REFRESH_INTERVAL);
            });
        })();
    </script>
}
